<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- grafitový kov s měděným lemem -->
    <item><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#3A434D" android:centerColor="#252C34" android:endColor="#14191F" />
        <corners android:radius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <stroke android:width="2dp" android:color="#C8793A" />
        <corners android:radius="24dp" />
    </shape></item>
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp"><shape android:shape="rectangle">
        <stroke android:width="1dp" android:color="#33FFD2A8" />
        <corners android:radius="21dp" />
    </shape></item>
</layer-list>
